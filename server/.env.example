# --- Core ---
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexgen_receptionist
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API (web app). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:5173
# Public HTTPS URL of this server (used when registering the agent's tools with ElevenLabs)
PUBLIC_URL=https://api.example.com

# --- First admin user (created by `npm run db:seed`) ---
SEED_ADMIN_NAME=Anwar
SEED_ADMIN_EMAIL=admin@nexgenhair.in
SEED_ADMIN_PASSWORD=change-me

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_6401m6rq5wm9f8e9g9np047anfaw
# Secret shown when you add the post-call webhook in the ElevenLabs dashboard
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret the agent sends (x-agent-secret header) when it calls this server's tools
AGENT_TOOL_SECRET=change-me-too

# --- Lead delivery (all optional; leave blank to switch off) ---
# WhatsApp Cloud API (Meta). Business-initiated messages need approved templates.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Template names. Params: booking = {{1}} name, {{2}} date/time, {{3}} doctor
WHATSAPP_TPL_BOOKING=appointment_confirmation
# lead alert = {{1}} name, {{2}} phone, {{3}} summary
WHATSAPP_TPL_LEAD_ALERT=new_lead_alert
# reminder = {{1}} name, {{2}} date/time
WHATSAPP_TPL_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_LANG=en
# Counsellor's WhatsApp number that receives new-lead alerts, e.g. +9198XXXXXXXX
COUNSELLOR_WHATSAPP=
# Clinic OS lead intake endpoint
CLINIC_OS_WEBHOOK_URL=
CLINIC_OS_WEBHOOK_TOKEN=
# Google Apps Script web-app URL that appends a row to a sheet
GOOGLE_SHEET_WEBHOOK_URL=
